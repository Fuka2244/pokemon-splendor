{
  "name": "pokemon-splendor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev:online",
    "start:local": "node server.mjs",
    "build": "node tools/build-web.mjs",
    "dev:online": "npm run build && wrangler dev --ip 127.0.0.1 --port 4174",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test:online": "node tools/check-online.mjs",
    "prototype": "node prototype/server.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
